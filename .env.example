# ============================================================
#  CNC Pricing Console · 环境变量模板
#  - 本地开发:复制本文件为 .env (gitignored) 并填入真实值
#                同时把对应值写入 config.js (由 config.example.js 复制而来)
#  - Vercel 部署:在 Vercel Dashboard → Settings → Environment Variables
#                添加下列两条同名变量,Build 时会自动生成 config.js
# ============================================================

# Supabase 项目 URL
# 取自:Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase Anon Public Key (前端公开使用,受 RLS 保护)
# 取自:Supabase Dashboard → Project Settings → API → anon public
# 注意:严禁把 service_role key 放到这里 - 那把会绕过 RLS
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5...
